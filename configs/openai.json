{
  "name": "GPT-4.1 mini (OpenAI)",
  "connector": "openai",
  "baseUrl": "https://api.openai.com/v1",
  "model": "gpt-4.1-mini",
  "apiKeyEnv": "OPENAI_API_KEY",
  "answer": "auto",
  "maxTokensField": "max_completion_tokens",
  "concurrency": 8,
  "note": "logprobs give real probabilities on non-reasoning models"
}
